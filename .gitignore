# Unity .gitignore Template
# Bingo Game - Unity 2D / Universal 2D
# Place this file at the root of the Unity project, beside Assets, Packages, and ProjectSettings.
#
# Based on GitHub's Unity.gitignore:
# https://github.com/github/gitignore/blob/main/Unity.gitignore

# ----------------------------------------------------------------------
# Unity generated folders - do not commit
# ----------------------------------------------------------------------
.utmp/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# ----------------------------------------------------------------------
# Unity generated/cache files
# ----------------------------------------------------------------------
*.log
sysinfo.txt
mono_crash.*
*.stackdump

# ----------------------------------------------------------------------
# Memory captures / recordings
# ----------------------------------------------------------------------
/[Mm]emoryCaptures/
/[Rr]ecordings/

# ----------------------------------------------------------------------
# Asset Store tools - uncomment if this package is imported later
# ----------------------------------------------------------------------
# /[Aa]ssets/AssetStoreTools*

# ----------------------------------------------------------------------
# IDE / editor generated files
# ----------------------------------------------------------------------
.vs/
.vscode/
.idea/
.gradle/
ExportedObj/
.consulo/

*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.DotSettings.user

# Autogenerated JetBrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Unity generated meta files for ignored/generated debug symbols
*.pidb.meta
*.pdb.meta
*.mdb.meta

# ----------------------------------------------------------------------
# Build outputs / distributables
# ----------------------------------------------------------------------
*.apk
*.aab
*.app
*.exe
*.x86
*.x86_64
*.dmg
*.ipa
*.unitypackage
*.unitypackage.meta

# ----------------------------------------------------------------------
# Crashlytics generated file
# ----------------------------------------------------------------------
crashlytics-build.properties

# ----------------------------------------------------------------------
# TestRunner generated files
# ----------------------------------------------------------------------
InitTestScene*.unity*
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# ----------------------------------------------------------------------
# Addressables generated files
# ----------------------------------------------------------------------
/ServerData
/[Aa]ssets/StreamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/Addressables_Temp*
/[Aa]ssets/AddressableAssetsData/*/*.bin*

# ----------------------------------------------------------------------
# Visual Scripting auto-generated files
# ----------------------------------------------------------------------
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# ----------------------------------------------------------------------
# Blender temporary backup files
# ----------------------------------------------------------------------
*.blend1
*.blend1.meta

# ----------------------------------------------------------------------
# OS generated files
# ----------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ----------------------------------------------------------------------
# Project-specific local import/drop folders
# ----------------------------------------------------------------------
/[Aa]ssets/[Ii]mport/

# ----------------------------------------------------------------------
# Unity Package Manager
# ----------------------------------------------------------------------
# Do NOT ignore the whole Packages folder.
# These should stay tracked:
#   Packages/manifest.json
#   Packages/packages-lock.json
#
# If Unity created an embedded URP source folder during the earlier URP issue
# and we are NOT intentionally editing URP source, ignore it so Git does not try
# to commit the whole package source. Remove this line only if we intentionally
# customize/own the embedded URP package.
/[Pp]ackages/com.unity.render-pipelines.universal/

# ----------------------------------------------------------------------
# Local ChatGPT planning and working files - do not commit
# ----------------------------------------------------------------------
/ChatGPT/
